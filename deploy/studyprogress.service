[Unit]
Description=StudyProgress API
After=network-online.target
Wants=network-online.target

[Service]
User=studyprogress
Group=studyprogress
WorkingDirectory=/opt/studyprogress
EnvironmentFile=/etc/studyprogress.env
ExecStart=/usr/bin/java -jar /opt/studyprogress/app.jar
Restart=on-failure
RestartSec=10
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
